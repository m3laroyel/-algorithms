		}
		}
		
		fclose(f1);
		
		f1 = fopen("input.txt", "r");
		if(f1 == NULL){
			printf("error");
			return 1;
		}
		
		int *vector = (int*)malloc(n * sizeof(int));
		
		while(count < n && fscanf(f1, "%d", &vector[count]) == 1){
			count ++;	
		}
		fclose(f1);
		
		rows = count / m;
		
		int** matrix = (int**)malloc(rows * sizeof(int*));
		for(i = 0; i < rows; i++){
			matrix[i] = (int*)malloc(m * sizeof(int));
		}
		
		int* row_sum = (int*)calloc(rows, sizeof(int));
		int* column_sum = (int*)calloc(m,  sizeof(int));
		
		
		for(i = 0; i < rows; i++){
			for(j = 0; j < m; j++){
				matrix[i][j] = vector[i * m + j];
				row_sum[i] += matrix[i][j];
				column_sum[j] += matrix[i][j];	
			}
		}
		
		
		
		for(i = 0; i < rows; i++){
			for(j = 0; j < m; j++){
				printf("%d ", matrix[i][j]);
			}
