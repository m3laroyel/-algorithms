#include <math.h>

int main() {
	setlocale(LC_ALL, "Russian");
	FILE *f1, *f2;
	int n, i, j, num, count = 0, m, rows;
	printf("enter quantity of numbers: ");
	scanf("%d", &n);
	
	printf("enter quantity of column: ");
	scanf("%d", &m);
	
	f1 = fopen("input.txt", "w");
	srand(time(NULL));
	
	for(i = 0; i < n; i++){
		num = rand() % 10 + 1;
		fprintf(f1, "%d ", num);
	}
	
	fclose(f1);
	
	f1 = fopen("input.txt", "r");
	f2 = fopen("output.txt", "w");
	
	while(fscanf(f1, "%d", &num) == 1){
		if(num % 5 == 0 || num % 7 == 0){
			fprintf(f2, "ÏßÒÜÑÅÌÜ");
		}
		else if(num % 5 == 0){
			fprintf(f2, "ÏßÒÜ");
			}
		else if(num % 7 == 0){
